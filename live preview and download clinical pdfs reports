        f"{'HIGH STRESS' if pred == 1 else 'LOW STRESS'} ({prob*100:.1f}% confidence). "
        f"Resting HR={fmt_num(row[c['hr']])} bpm, Delta Interview HR={fmt_num(row['Delta_Interview_HR'], '+.1f')} bpm, "
        f"Delta RR={fmt_num(row['Delta_RR'], '+.1f')} br/min, EDA={fmt_num(row[c['eda']], '.2f')} uS, "
