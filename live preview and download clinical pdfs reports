def train_and_cache(df: pd.DataFrame, cols: dict, raw_feats: list, upg_feats: list):
    y = df["Label"].values
    X_raw = df[raw_feats]
    X_upg = df[upg_feats]

    strat = y if (len(np.unique(y)) > 1 and pd.Series(y).value_counts().min() >= 2) else None
    test_sz = 0.25 if len(df) >= 20 else 0.3
    idx_train, idx_test = train_test_split(df.index, test_size=test_sz, random_state=42, stratify=strat)

    base_rf = make_pipe(RandomForestClassifier(n_estimators=120, n_jobs=-1, random_state=42))
    upg_rf = make_pipe(RandomForestClassifier(n_estimators=180, max_depth=8, n_jobs=-1, random_state=42))
    upg_ada = make_pipe(
        AdaBoostClassifier(
            estimator=DecisionTreeClassifier(max_depth=2, random_state=42),
            n_estimators=90,
            random_state=42,
        )
    )

    base_rf.fit(X_raw.loc[idx_train], df.loc[idx_train, "Label"])
    upg_rf.fit(X_upg.loc[idx_train], df.loc[idx_train, "Label"])
    upg_ada.fit(X_upg.loc[idx_train], df.loc[idx_train, "Label"])

    y_test = df.loc[idx_test, "Label"].values
    metrics = {}
    roc_data = {}

    for name, mdl, X_te in [
        (KEY_BASE_RF, base_rf, X_raw.loc[idx_test]),
        (KEY_UPG_RF, upg_rf, X_upg.loc[idx_test]),
        (KEY_UPG_ADA, upg_ada, X_upg.loc[idx_test]),
    ]:
        preds = mdl.predict(X_te)
        proba_mat = mdl.predict_proba(X_te)
        probs = proba_mat[:, 1] if proba_mat.shape[1] > 1 else proba_mat[:, 0]
        if len(np.unique(y_test)) > 1:
            auc = round(roc_auc_score(y_test, probs), 3)
            fpr, tpr, _ = roc_curve(y_test, probs)
            fpr_l, tpr_l = fpr.tolist(), tpr.tolist()
        else:
            auc, fpr_l, tpr_l = 0.0, [0, 1], [0, 1]

        metrics[name] = {
            "acc": round(accuracy_score(y_test, preds) * 100, 1),
            "prec": round(precision_score(y_test, preds, zero_division=0) * 100, 1),
            "rec": round(recall_score(y_test, preds, zero_division=0) * 100, 1),
            "f1": round(f1_score(y_test, preds, zero_division=0) * 100, 1),
            "auc": auc,
        }
        roc_data[name] = {"fpr": fpr_l, "tpr": tpr_l, "auc": auc}

    cm = confusion_matrix(y_test, upg_rf.predict(X_upg.loc[idx_test]), labels=[0, 1])
    fi_df = (
        pd.DataFrame({"Feature": upg_feats, "Importance": upg_rf.named_steps["clf"].feature_importances_})
        .sort_values("Importance", ascending=True)
        .tail(10)
    )

    # Pre-compute predictions for all rows ONCE -> Lightspeed patient navigation
    all_proba = upg_rf.predict_proba(X_upg)
    df["Pred_Prob"] = all_proba[:, 1] if all_proba.shape[1] > 1 else all_proba[:, 0]
    df["Pred_Label"] = upg_rf.predict(X_upg)

    STATE.update({
        "df": df,
        "cols": cols,
        "raw_feats": raw_feats,
        "upg_feats": upg_feats,
        "base_rf": base_rf,
        "upg_rf": upg_rf,
        "upg_ada": upg_ada,
        "metrics": metrics,
        "roc_data": roc_data,
        "cm": cm,
        "fi_df": fi_df,
    })

    # Pre-cache static cohort charts ONCE
    STATE["cached_figs"] = {
        "roc": build_roc_fig(),
        "cm": build_cm_fig(),
        "fi": build_fi_fig(),
        "violin": build_violin_fig(),
        "sankey": build_architecture_sankey(),
    }


def compute_live_vitals_sample(row: pd.Series, tick: int, pred: int):
    c = STATE["cols"]
    base_hr = safe_num(row[c["hr"]], 72.0)
    int_hr = safe_num(row[c["int"]], base_hr + 10.0)
    base_eda = safe_num(row[c["eda"]], 2.5)
    base_rr = safe_num(row[c["rr"]], 15.0)
    stress_rr = safe_num(row[c["srr"]], base_rr + 2.0)

    t = np.arange(tick - 39, tick + 1)
    stress_amp = 1.0 if pred == 1 else 0.35

    hr_stream = (
        base_hr
        + (int_hr - base_hr) * 0.48 * (0.5 + 0.5 * np.sin(t / 6.5))
        + stress_amp * 2.5 * np.sin(t / 1.8)
        + np.cos(t / 2.9) * 1.0
    )
    eda_stream = np.clip(
        base_eda + stress_amp * 0.55 * np.sin(t / 4.8 + 0.6) + 0.15 * np.cos(t / 2.1),
        0.15,
        None,
    )
    rr_stream = (
        base_rr
        + (stress_rr - base_rr) * 0.45 * (0.5 + 0.5 * np.cos(t / 5.5))
        + 0.5 * np.sin(t / 1.7)
    )
    return t, np.round(hr_stream, 1), np.round(eda_stream, 2), np.round(rr_stream, 1)


