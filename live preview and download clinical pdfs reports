def build_live_telemetry_fig(row: pd.Series, tick: int, pred: int, row_idx: int):
    c = STATE["cols"]
    pid = str(row[c["pid"]])
    base_hr = safe_num(row[c["hr"]], 72.0)
    t, hr_s, eda_s, rr_s = compute_live_vitals_sample(row, tick, pred)

    fig = go.Figure()
    fig.add_trace(go.Scatter(
        x=t, y=hr_s, mode="lines+markers",
        name=f"Live HR ({hr_s[-1]:.1f} bpm)",
        line=dict(color="#ef4444" if pred == 1 else "#38bdf8", width=2.8),
        marker=dict(size=4),
    ))
    fig.add_hline(
        y=base_hr, line_dash="dash", line_color="#64748b",
        annotation_text=f"Baseline HR: {base_hr:.1f}", annotation_position="bottom right",
    )
    fig.add_trace(go.Scatter(
        x=t, y=eda_s, mode="lines",
        name=f"Live EDA ({eda_s[-1]:.2f} µS)", yaxis="y2",
        line=dict(color="#f59e0b", width=2.2),
    ))
    fig.add_trace(go.Scatter(
        x=t, y=rr_s, mode="lines",
        name=f"Live Resp ({rr_s[-1]:.1f} br/m)", yaxis="y2",
        line=dict(color="#10b981", width=1.9, dash="dot"),
    ))
    fig.update_layout(
        template="plotly_dark",
        paper_bgcolor="rgba(0,0,0,0)",
        plot_bgcolor="rgba(15,23,42,0.5)",
        font=dict(color="#e2e8f0", size=12),
        title=f"LIVE TELEMETRY STREAM — Active Patient: {pid} (t={tick}s • 1Hz Feed)",
        xaxis=dict(title="Rolling 40-Second Telemetry Window", gridcolor="#1e293b"),
        yaxis=dict(title="Heart Rate (bpm)", gridcolor="#1e293b"),
        yaxis2=dict(title="EDA (µS) / Resp Rate", overlaying="y", side="right", showgrid=False),
        height=280,
        margin=dict(l=48, r=48, t=46, b=36),
        legend=dict(orientation="h", yanchor="bottom", y=1.02, xanchor="right", x=1),
        uirevision=f"pt-{row_idx}",
    )
    return fig


