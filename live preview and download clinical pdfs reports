def fcol(columns, *keys):
    return next((c for c in columns if all(k in c.lower() for k in keys)), None)


def safe_num(val, default=0.0):
    try:
        v = float(val)
        return default if (np.isnan(v) or np.isinf(v)) else v
    except Exception:
        return default


def fmt_num(val, spec=".1f", default="N/A"):
    try:
        v = float(val)
        return default if (np.isnan(v) or np.isinf(v)) else format(v, spec)
    except Exception:
        return default


def pdf_safe(text: str) -> str:
    s = str(text)
    for k, v in {
        "Δ": "Delta ", "µ": "u", "°": " deg ", "—": "-", "–": "-",
        "•": "*", "→": "->", "&": "&amp;", "<": "&lt;", ">": "&gt;",
    }.items():
        s = s.replace(k, v)
    return s.encode("latin-1", "replace").decode("latin-1")


def normalize_binary_labels(series: pd.Series) -> pd.Series:
    num = pd.to_numeric(series, errors="coerce")
    if num.notna().mean() > 0.8:
        vals = sorted(num.dropna().unique().tolist())
        if set(vals).issubset({0, 1}):
            return num.fillna(0).astype(int)
        median_split = num.median()
        return (num.fillna(median_split) > median_split).astype(int)

    low_tokens = {"0", "low", "no", "normal", "baseline", "calm", "relaxed", "no stress", "non-stress", "false"}
    return series.astype(str).str.strip().str.lower().apply(lambda x: 0 if x in low_tokens else 1).astype(int)


def prepare_dataframe(df_raw: pd.DataFrame):
    df = df_raw.copy()
    df.columns = [str(c).strip() for c in df.columns]
    notes = []

    c_pid = fcol(df.columns, "participant") or fcol(df.columns, "subject") or fcol(df.columns, "id")
    c_name = fcol(df.columns, "name")
    c_age = fcol(df.columns, "age")
    c_gen = fcol(df.columns, "gender") or fcol(df.columns, "sex")
    c_pss = fcol(df.columns, "pss")
    c_ss = fcol(df.columns, "stai", "state") or fcol(df.columns, "state")
    c_st = fcol(df.columns, "stai", "trait") or fcol(df.columns, "trait")
    c_hr = next(
        (c for c in df.columns if c.lower() in ["hr", "heart_rate", "heart rate", "resting_hr", "baseline_hr"]),
        fcol(df.columns, "hr") or fcol(df.columns, "heart"),
    )
    c_str = fcol(df.columns, "stroop")
    c_int = fcol(df.columns, "interview")
    c_hyp = fcol(df.columns, "hypervent")
    c_rr = next(
        (c for c in df.columns if c.lower() in ["rr", "resp_rate", "respiratory_rate", "resp"]),
        fcol(df.columns, "rr") or fcol(df.columns, "resp"),
    )
    c_srr = fcol(df.columns, "stress", "resp") or fcol(df.columns, "stress", "rr")
    c_eda = fcol(df.columns, "eda") or fcol(df.columns, "gsr") or fcol(df.columns, "conductance")
    c_tmp = fcol(df.columns, "temp")
    c_lbl = fcol(df.columns, "label") or fcol(df.columns, "target") or fcol(df.columns, "stress_level") or fcol(df.columns, "class")

    missing_req = [k for k, v in {"Heart Rate (HR)": c_hr, "Label/Target": c_lbl}.items() if v is None]
    if missing_req:
        raise ValueError(
            f"Missing required column(s): {', '.join(missing_req)}. "
            f"Found columns: {', '.join(df.columns[:12])}"
        )

    df = df.dropna(subset=[c_lbl]).copy().reset_index(drop=True)
    if len(df) < 8:
        raise ValueError(f"Dataset needs at least 8 valid rows for ML training (found {len(df)}).")

    df["Label"] = normalize_binary_labels(df[c_lbl])
    df[c_hr] = pd.to_numeric(df[c_hr], errors="coerce")

    if c_rr is None:
        df["RR_Auto"] = 15.0
        c_rr = "RR_Auto"
        notes.append("RR missing -> defaulted to 15.0")
    else:
        df[c_rr] = pd.to_numeric(df[c_rr], errors="coerce")

    optional_map = [
        ("Stroop HR", c_str, "Stroop_HR_Auto", df[c_hr]),
        ("Interview HR", c_int, "Interview_HR_Auto", df[c_hr]),
        ("Hypervent HR", c_hyp, "Hypervent_HR_Auto", df[c_hr]),
        ("Stress RR", c_srr, "Stress_RR_Auto", df[c_rr]),
        ("EDA", c_eda, "EDA_Auto", 2.0),
        ("Temp", c_tmp, "Temp_Auto", 33.5),
        ("Age", c_age, "Age_Auto", 30.0),
        ("PSS", c_pss, "PSS_Auto", 18.0),
        ("STAI State", c_ss, "STAI_State_Auto", 40.0),
        ("STAI Trait", c_st, "STAI_Trait_Auto", 38.0),
    ]
    resolved = []
    for label_name, ref, fallback_col, fill_val in optional_map:
        if ref is None:
            df[fallback_col] = fill_val
            resolved.append(fallback_col)
            notes.append(f"{label_name} imputed")
        else:
            df[ref] = pd.to_numeric(df[ref], errors="coerce")
            resolved.append(ref)
    c_str, c_int, c_hyp, c_srr, c_eda, c_tmp, c_age, c_pss, c_ss, c_st = resolved

    if c_pid is None:
        df["Participant_ID"] = [f"P-{i+1:03d}" for i in range(len(df))]
        c_pid = "Participant_ID"

    df["Cohort"] = (
        df[c_name].astype(str).str.split("_").str[1].fillna("General")
        if c_name else "Uploaded Cohort"
    )
    df["Gender_Num"] = (df[c_gen].astype(str).str.lower().str.startswith("m")).astype(int) if c_gen else 0

    # Personalized Baseline-Delta Features
    df["Delta_Stroop_HR"] = df[c_str] - df[c_hr]
    df["Delta_Interview_HR"] = df[c_int] - df[c_hr]
    df["Delta_Hypervent_HR"] = df[c_hyp] - df[c_hr]
    df["Delta_RR"] = df[c_srr] - df[c_rr]
    df["Pct_Interview_HR"] = df["Delta_Interview_HR"] / (df[c_hr].abs() + 1e-5)
    df["Mean_Task_HR_Delta"] = df[["Delta_Stroop_HR", "Delta_Interview_HR", "Delta_Hypervent_HR"]].mean(axis=1)
    df["STAI_Delta"] = df[c_ss] - df[c_st]

    cols = {
        "pid": c_pid, "name": c_name, "age": c_age, "gen": c_gen,
        "pss": c_pss, "ss": c_ss, "st": c_st, "hr": c_hr,
        "str": c_str, "int": c_int, "hyp": c_hyp, "rr": c_rr,
        "srr": c_srr, "eda": c_eda, "tmp": c_tmp,
    }
    raw_feats = [c_hr, c_rr]
    upg_feats = [
        c_hr, c_rr, "Delta_Stroop_HR", "Delta_Interview_HR", "Delta_Hypervent_HR",
        "Delta_RR", "Pct_Interview_HR", "Mean_Task_HR_Delta", c_eda, c_tmp,
        c_age, "Gender_Num", c_pss, c_ss, c_st, "STAI_Delta",
    ]
    return df, cols, raw_feats, upg_feats, notes


def make_pipe(estimator):
    return Pipeline([
        ("imp", SimpleImputer(strategy="median")),
        ("sc", RobustScaler()),
        ("clf", estimator),
    ])


def call_local_ollama_mistral(prompt: str):
    try:
        req = urllib.request.Request(
            OLLAMA_URL,
            data=json.dumps({"model": OLLAMA_MODEL, "prompt": prompt, "stream": False}).encode("utf-8"),
            headers={"Content-Type": "application/json"},
        )
        with urllib.request.urlopen(req, timeout=2.5) as resp:
            txt = json.loads(resp.read().decode("utf-8")).get("response", "").strip()
            if txt:
                return txt, f"Ollama Local ({OLLAMA_MODEL})"
    except Exception:
        pass
    return None, None


