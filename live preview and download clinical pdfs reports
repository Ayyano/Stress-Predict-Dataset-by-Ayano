def make_scaled_rl_image(img_path: str, max_w: float, max_h: float) -> RLImage:
    """Preserves exact pixel aspect ratio so charts NEVER stretch, clip, or overlap."""
    h_px, w_px = mpimg.imread(img_path).shape[:2]
    scale = min(max_w / w_px, max_h / h_px)
    return RLImage(img_path, width=w_px * scale, height=h_px * scale)


def make_vector_risk_bar(prob: float, pred: int, width=200, height=34) -> Drawing:
    """Crisp native vector risk meter for PDF (zero matplotlib polar clipping)."""
    d = Drawing(width, height)
    bar_y, bar_h = 8, 12
    fill_color = colors.HexColor("#dc2626") if pred == 1 else colors.HexColor("#059669")
    # Background track
    d.add(Rect(0, bar_y, width, bar_h, rx=6, ry=6, fillColor=colors.HexColor("#e2e8f0"), strokeWidth=0))
    # Active fill
    fill_w = max(8, width * min(max(prob, 0.0), 1.0))
    d.add(Rect(0, bar_y, fill_w, bar_h, rx=6, ry=6, fillColor=fill_color, strokeWidth=0))
    # 50% threshold tick
    d.add(Rect(width * 0.5 - 0.75, bar_y - 2, 1.5, bar_h + 4, fillColor=colors.HexColor("#0f172a"), strokeWidth=0))
    # Top labels
    d.add(String(0, bar_y + bar_h + 5, "0% Low", fontName="Helvetica", fontSize=7.5, fillColor=colors.HexColor("#475569")))
    d.add(String(width * 0.5 - 10, bar_y + bar_h + 5, "50%", fontName="Helvetica-Bold", fontSize=7.5, fillColor=colors.HexColor("#0f172a")))
    d.add(String(width - 36, bar_y + bar_h + 5, "100% High", fontName="Helvetica", fontSize=7.5, fillColor=colors.HexColor("#475569")))
    return d


